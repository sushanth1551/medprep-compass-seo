# Copy this file to ".env" and fill it in yourself. Never commit ".env" and never
# paste a real key into this example file, chat, source code, or documentation.

# mock = offline, no key, no cost.  groq / claude = real API requests that may cost money.
AI_PROVIDER=mock

# Needed only when AI_PROVIDER=groq. Use a model id from your Groq console.
GROQ_API_KEY=
GROQ_MODEL=

# Needed only when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional settings (defaults shown)
# MAX_OUTPUT_TOKENS=8000
# PROMPT_STYLE=structured
# GROQ_REASONING_EFFORT=low
# MAX_CONTINUATION_CALLS=1
# REGENERATE_FAILED_SECTIONS=false
# GROQ_TIMEOUT_SECONDS=120
# ANTHROPIC_TIMEOUT_SECONDS=120
